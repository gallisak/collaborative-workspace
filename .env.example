NODE_ENV=development
API_PORT=4000
COLLAB_PORT=4001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
LOG_PRETTY=true
TRUST_PROXY=1
FRONTEND_URL=http://localhost:3000

POSTGRES_USER=collab
POSTGRES_PASSWORD=collab
POSTGRES_DB=collab_docs
POSTGRES_PORT=5432
DATABASE_URL=postgresql://collab:collab@localhost:5432/collab_docs

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=collab-docs

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
REFRESH_TOKEN_TTL=30d

INVITATION_TTL=7d

COLLAB_FLUSH_INTERVAL_MS=1000
COLLAB_COMPACTION_THRESHOLD=100
COLLAB_MAX_MESSAGE_BYTES=5000000
COLLAB_HEARTBEAT_MS=30000
VERSION_INTERVAL_MS=600000
VERSION_RETENTION_AUTO=50

REVALIDATE_URL=http://localhost:3000/internal/revalidate
REVALIDATE_SECRET=dev-revalidate-secret-change-me
REVALIDATE_DELAY_MS=5000

SEARCH_INDEX_DELAY_MS=2000
SEARCH_RECONCILE_INTERVAL_MS=600000

BILLING_WEBHOOK_SECRET=dev-billing-webhook-secret-change-me
CHECKOUT_SESSION_TTL=30m
SUBSCRIPTION_PERIOD=30d
