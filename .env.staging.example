SEARCH_INDEX_DELAY_MS=2000
SEARCH_RECONCILE_INTERVAL_MS=600000

BILLING_WEBHOOK_SECRET=
CHECKOUT_SESSION_TTL=30m
SUBSCRIPTION_PERIOD=30d

ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_UPLOAD_TTL=15m
ATTACHMENT_DOWNLOAD_TTL=5m
ATTACHMENT_CLEANUP_INTERVAL_MS=3600000

API_INTERNAL_URL=http://api:4000
