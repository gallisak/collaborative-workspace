S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=collab-docs-staging

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=30d

INVITATION_TTL=7d

COLLAB_FLUSH_INTERVAL_MS=1000
COLLAB_COMPACTION_THRESHOLD=100
COLLAB_MAX_MESSAGE_BYTES=5000000
COLLAB_HEARTBEAT_MS=30000
VERSION_INTERVAL_MS=600000
VERSION_RETENTION_AUTO=50

REVALIDATE_URL=https://staging.collab-docs.local/internal/revalidate
REVALIDATE_SECRET=
