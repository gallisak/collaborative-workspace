NODE_ENV=production
API_PORT=4000
COLLAB_PORT=4001
WORKER_PORT=4002
CORS_ORIGIN=https://staging.collab-docs.local
LOG_LEVEL=info
LOG_PRETTY=false
TRUST_PROXY=1
FRONTEND_URL=https://staging.collab-docs.local

POSTGRES_USER=collab
POSTGRES_PASSWORD=
POSTGRES_DB=collab_docs_staging
POSTGRES_PORT=5432
DATABASE_URL=

REDIS_PORT=6380
